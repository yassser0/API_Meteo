# Exemple de configuration (copier en .env et adapter)
# Les variables sont préfixées API_METEO_

# --- Serveur ---
API_METEO_HOST=127.0.0.1
API_METEO_PORT=8000
API_METEO_RELOAD=false

# --- Simulation ---
# Intervalle en secondes entre chaque génération automatique
API_METEO_SIMULATION_INTERVAL_SECONDS=10
# Nombre max de mesures en mémoire par ville
API_METEO_MAX_RECORDS_IN_MEMORY=1000

# --- Mode anomalie ---
# false = données cohérentes (production)
# true  = injection d'anomalies synthétiques (tests Databricks)
API_METEO_ANOMALY_MODE=false
# Probabilité d'anomalie par mesure (0.0 à 1.0), si ANOMALY_MODE=true
API_METEO_ANOMALY_PROBABILITY=0.1

# --- Export ---
API_METEO_EXPORT_DIR=exports

# --- Logs ---
# DEBUG, INFO, WARNING, ERROR
API_METEO_LOG_LEVEL=INFO
